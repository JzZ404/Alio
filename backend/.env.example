# Copy to backend/.env and fill in real values. Never commit the real .env.

# Google Gemma via the Gen AI SDK (https://ai.google.dev/)
# This is the default path: every AI call goes to Google's hosted model, and
# the text of visit notes and lab reports goes with it.
GOOGLE_API_KEY=your-google-ai-api-key

# Our own fine-tuned model instead, served locally by Ollama. Off by default
# because it needs a 3.4 GB download and `ollama serve` running. With it on,
# no note text leaves the machine (except lab-photo OCR — see backend/README).
# Setup: backend/README.md → "Running on the fine-tuned model".
# USE_LOCAL_OLLAMA=1
# OLLAMA_MODEL=alio-medical
# OLLAMA_URL=http://localhost:11434

# Supabase — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Anon (publishable) key is fine for local dev; FastAPI also reads/writes
# under permissive RLS policies defined in supabase/schema.sql.
# Exception: anything that updates family_messages beyond the three allowed
# transitions (e.g. the timeout follow-up job) needs the service-role key —
# the update guard exempts service_role and postgres, not anon.
SUPABASE_KEY=eyJhbGciOi...your-anon-jwt
